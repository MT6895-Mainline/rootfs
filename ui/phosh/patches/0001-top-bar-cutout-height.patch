+guint
+phosh_layout_manager_get_top_bar_height (PhoshLayoutManager *self)
+{
+  GListModel *cutouts;
+  float scale;
+  guint height = PHOSH_TOP_BAR_HEIGHT;
+
+  g_return_val_if_fail (PHOSH_IS_LAYOUT_MANAGER (self), height);
+
+  if (self->layout != PHOSH_SHELL_LAYOUT_DEVICE || self->panel == NULL ||
+      self->builtin == NULL || !phosh_monitor_is_configured (self->builtin))
+    return height;
+
+  if (phosh_monitor_get_transform (self->builtin) != PHOSH_MONITOR_TRANSFORM_NORMAL ||
+      phosh_shell_get_primary_monitor (phosh_shell_get_default ()) != self->builtin)
+    return height;
+
+  scale = phosh_monitor_get_fractional_scale (self->builtin);
+  if (!isfinite (scale) || scale <= 0)
+    return height;
+
+  /* Cover top-edge cutouts in logical coordinates; leave other edges unchanged. */
+  cutouts = gm_display_panel_get_cutouts (self->panel);
+  for (guint i = 0; i < g_list_model_get_n_items (cutouts); i++) {
+    g_autoptr (GmCutout) cutout = g_list_model_get_item (cutouts, i);
+    const GmRect *bounds = gm_cutout_get_bounds (cutout);
+    double bottom = ceil ((bounds->y + bounds->height) / scale);
+
+    if (bounds->y < 0 || bounds->y >= PHOSH_TOP_BAR_HEIGHT * scale ||
+        bounds->x + bounds->width <= 0 || bounds->x >= self->builtin->width ||
+        bottom > self->builtin->height / scale / 4.0)
+      continue;
+
+    height = MAX (height, bottom);
+  }
+
+  return height;
+}
