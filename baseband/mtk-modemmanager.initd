#!/sbin/openrc-run
# shellcheck shell=sh
description="MediaTek CCCI ModemManager bundle"
command="/usr/bin/python3"
command_args="/usr/libexec/mtk-ccci/run-limited.py --role modemmanager"
command_background=yes
pidfile="/run/mtk-ccci/modemmanager.pid"
retry="TERM/10/KILL/5"
umask=0077
output_log="/var/lib/mtk-ccci/qqcandy-532/evidence/service-mm.log"
error_log="/var/lib/mtk-ccci/qqcandy-532/evidence/service-mm-error.log"

depend() {
	need dbus mtk-ccci-owner
}

start_pre() {
	# Never create a second owner of the ModemManager D-Bus name.
	! rc-service modemmanager status >/dev/null 2>&1 || return 1
	/usr/bin/python3 /usr/libexec/mtk-ccci/wait-ready.py
}
