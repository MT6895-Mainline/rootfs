#!/bin/sh
# MT6895-Mainline first boot:
#   - grow the root filesystem to fill the partition it was flashed into
#     (the .img is intentionally smaller than the userdata partition)
#   - generate a fresh machine-id (images are built with an empty one)
set -e

ROOT="$(findmnt -no SOURCE / 2>/dev/null || true)"
if [ -n "$ROOT" ] && [ -b "$ROOT" ]; then
	if resize2fs "$ROOT" >/dev/null 2>&1; then
		echo "mt6895-firstboot: resized $ROOT"
	else
		echo "mt6895-firstboot: resize2fs on $ROOT not needed or failed"
	fi
fi

if [ ! -s /etc/machine-id ]; then
	systemd-machine-id-setup || true
fi

# regenerate the ssh host keys of this particular installation
if command -v ssh-keygen >/dev/null 2>&1; then
	rm -f /etc/ssh/ssh_host_*
	ssh-keygen -A >/dev/null 2>&1 || true
fi

touch /var/lib/mt6895-firstboot-done
