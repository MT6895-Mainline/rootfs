# mediatek_v2 supplies its own CMDQ API; arm64 defconfig enables the
# incompatible mainline helper as a module despite qqcandy.config's comment.
CONFIG_MTK_CMDQ=n

# WORKAROUND: the opt-in bring-up diagnostic calls ccif_lock_md_clock(),
# which has no implementation in this revision. Do not ship that experiment
# in normal images; repair/revalidate it separately, not with a dummy stub.
# The production CCCI core and guarded probe remain unchanged.
CONFIG_MTK_CCI_DIAG=n
