# SCP is built-in and calls the AFE semaphore notifier. Keep its provider
# built-in too, using qqcandy's MT6895/MT6368 audio hardware rather than an
# unrelated defconfig AFE. See scp/rv/scp_helper.c and mediatek/common/Makefile.
CONFIG_SND_SOC_MT6895=y
CONFIG_SND_SOC_MT6895_MT6368=y
CONFIG_SND_SOC_MT6368_ACCDET=y
